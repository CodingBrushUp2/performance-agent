<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>perfagent</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>perfagent</ToolCommandName>
    <PackageId>PerformanceAgent.Cli</PackageId>
    <Version>0.4.0</Version>
    <Authors>Performance Agent contributors</Authors>
    <Description>Evidence-driven performance regression checks for .NET.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../../src/PerformanceAgent.Core/PerformanceAgent.Core.csproj" />
    <ProjectReference Include="../../../src/PerformanceAgent.AI/PerformanceAgent.AI.csproj" />
    <ProjectReference Include="../../benchmark-host/PerformanceAgent.BenchmarkHost/PerformanceAgent.BenchmarkHost.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <InternalsVisibleTo Include="PerformanceAgent.Cli.IntegrationTests" />
  </ItemGroup>

  <!-- Keep the host isolated, including its deps/runtimeconfig and transitive assets. -->
  <Target Name="BundleBenchmarkHost" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)benchmark-host" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)../../benchmark-host/PerformanceAgent.BenchmarkHost/PerformanceAgent.BenchmarkHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);NoBuild=true;UseAppHost=false;PublishDir=$(TargetDir)benchmark-host/" />
  </Target>

  <Target Name="PublishBundledBenchmarkHost" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="BundleBenchmarkHost">
    <ItemGroup>
      <_BundledBenchmarkHost Include="$(TargetDir)benchmark-host/**/*" />
      <ResolvedFileToPublish Include="@(_BundledBenchmarkHost)">
        <RelativePath>benchmark-host/%(_BundledBenchmarkHost.RecursiveDir)%(_BundledBenchmarkHost.Filename)%(_BundledBenchmarkHost.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
